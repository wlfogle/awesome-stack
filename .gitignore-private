# Private Branch - Security .gitignore
# Never commit these files even on private branches

# Actual secrets and credentials
*.key
*.pem
*.p12
*.pfx
secrets.json
credentials.json
auth.json
tokens.json

# Encrypted secrets (already encrypted but be safe)
*.enc
master.key

# Configuration files with sensitive data
config.json
settings.json
local.json

# API Keys and tokens
api_keys.txt
*.token
*.secret

# SSH Keys
id_rsa
id_ecdsa
id_ed25519
*.pub
known_hosts

# Password files
passwords.txt
*.passwd
*.pwd

# Database files that might contain secrets
*.db
*.sqlite
*.sqlite3

# Environment files
.env
.env.local
.env.production
.env.development

# Log files that might contain sensitive data
*.log
logs/
rotation.log
auth.log

# Session and cache files
sessions/
cache/
temp/
tmp/

# Backup files
*.backup
*.bak
*.old

# OS specific files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Virtual environments
venv/
env/
ENV/

# IDE files
.vscode/
.idea/
*.sublime-*

# Temporary files
*.tmp
*.temp

# Never commit these even by accident
/Github General Access Token.txt
/Github\ General\ Access\ Token.txt

# Real configuration directories
.config/secrets/
.config/vpn-rotation/secrets.json
.config/warp-automation/*.json
